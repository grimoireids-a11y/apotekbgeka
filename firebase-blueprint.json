        "receiptFormat": { "type": "string", "maxLength": 40 },
        "rxFormat": { "type": "string", "maxLength": 40 },
        "updatedAt": { "type": "string" },
        "updatedBy": { "type": "string" }
      },
      "required": ["id", "practiceName", "updatedAt", "updatedBy"]
    },
    "Patient": {
      "title": "Patient",
