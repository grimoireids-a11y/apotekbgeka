        "gender": { "type": "string", "enum": ["Perempuan", "Laki-laki"] },
        "address": { "type": "string", "maxLength": 1000 },
        "phone": { "type": "string", "maxLength": 512 },
        "email": { "type": "string", "maxLength": 512 },
        "occupation": { "type": "string", "maxLength": 120 },
        "maritalStatus": { "type": "string", "maxLength": 40 },
        "spouseName": { "type": "string", "maxLength": 200 },
        "familyPhone": { "type": "string", "maxLength": 512 },
        "emergencyContact": { "type": "string", "maxLength": 512 },
        "bloodType": { "type": "string", "maxLength": 12 },
        "allergies": { "type": "string", "maxLength": 2000 },
        "medicalHistory": { "type": "string", "maxLength": 2000 },
        "surgicalHistory": { "type": "string", "maxLength": 2000 },
        "medicationHistory": { "type": "string", "maxLength": 2000 },
        "consentGiven": { "type": "boolean" },
        "active": { "type": "boolean" },
        "createdAt": { "type": "string" },
        "createdBy": { "type": "string" },
        "updatedAt": { "type": "string" },
        "updatedBy": { "type": "string" }
      },
      "required": ["id", "rmNumber", "fullName", "birthDate", "gender", "active", "createdAt", "createdBy", "updatedAt", "updatedBy"]
    },
