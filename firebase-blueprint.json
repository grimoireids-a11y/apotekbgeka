      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "rmNumber": { "type": "string", "maxLength": 40 },
        "nik": { "type": "string", "maxLength": 512 },
        "fullName": { "type": "string", "maxLength": 200 },
        "birthPlace": { "type": "string", "maxLength": 120 },
