      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "category": { "type": "string", "maxLength": 80 },
        "description": { "type": "string", "maxLength": 300 },
        "amount": { "type": "number" },
        "expenseDate": { "type": "string", "maxLength": 20 },
        "createdAt": { "type": "string" },
        "createdBy": { "type": "string" }
      },
      "required": ["id", "category", "amount", "expenseDate"]
    },
    "Appointment": {
      "title": "Appointment",
      "description": "Scheduled practice appointment or ANC follow-up control",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "patientId": { "type": "string", "maxLength": 128 },
        "doctorId": { "type": "string", "maxLength": 128 },
        "scheduledDate": { "type": "string", "maxLength": 20 },
        "scheduledTime": { "type": "string", "maxLength": 16 },
        "status": { "type": "string", "enum": ["Terjadwal", "Hadir", "Dijadwalkan Ulang", "Dibatalkan"] },
        "createdAt": { "type": "string" },
        "createdBy": { "type": "string" }
      },
      "required": ["id", "patientId", "scheduledDate", "status"]
    },
    "DocumentRecord": {
      "title": "DocumentRecord",
      "description": "Digital clinical or administrative document metadata",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "patientId": { "type": "string", "maxLength": 128 },
        "docType": { "type": "string", "maxLength": 64 },
        "title": { "type": "string", "maxLength": 200 },
        "createdAt": { "type": "string" },
        "createdBy": { "type": "string" }
      },
      "required": ["id", "docType", "title"]
    },
    "NotificationItem": {
      "title": "NotificationItem",
      "description": "Internal practice operational or clinical alert",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "category": { "type": "string", "maxLength": 48 },
        "title": { "type": "string", "maxLength": 160 },
        "message": { "type": "string", "maxLength": 500 },
        "read": { "type": "boolean" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "category", "title", "read", "createdAt"]
    },
    "AuditLog": {
      "title": "AuditLog",
      "description": "Immutable security and clinical activity audit trail",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "userName": { "type": "string", "maxLength": 160 },
        "role": { "type": "string", "maxLength": 40 },
        "action": { "type": "string", "maxLength": 120 },
        "entity": { "type": "string", "maxLength": 80 },
        "entityId": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "userId", "role", "action", "entity", "createdAt"]
    },
    "SystemSetting": {
      "title": "SystemSetting",
      "description": "Security policy, password policy, retention policy, and document templates",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 64 },
        "e2eeCloudWrappedKey": { "type": "string", "maxLength": 2048 },
        "updatedAt": { "type": "string" },
        "updatedBy": { "type": "string" }
      },
      "required": ["id", "updatedAt", "updatedBy"]
    },
    "IntegrationConfig": {
      "title": "IntegrationConfig",
      "description": "External API integration configs (SATUSEHAT FHIR, WhatsApp)",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 64 },
        "provider": { "type": "string", "maxLength": 64 },
        "enabled": { "type": "boolean" },
        "updatedAt": { "type": "string" },
        "updatedBy": { "type": "string" }
      },
      "required": ["id", "provider", "enabled"]
    },
    "BackupRecord": {
      "title": "BackupRecord",
      "description": "Metadata for encrypted database backup snapshots",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "label": { "type": "string", "maxLength": 160 },
        "encrypted": { "type": "boolean" },
        "recordCount": { "type": "number" },
        "createdAt": { "type": "string" },
        "createdBy": { "type": "string" }
      },
      "required": ["id", "label", "encrypted", "createdAt", "createdBy"]
    }
  },
