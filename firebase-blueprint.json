{
  "entities": {
    "UserAccount": {
      "title": "UserAccount",
      "description": "Practice staff account with role assignment and E2EE key wrapping metadata",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "username": { "type": "string", "maxLength": 64 },
        "displayName": { "type": "string", "maxLength": 120 },
        "email": { "type": "string", "format": "email", "maxLength": 160 },
        "role": { "type": "string", "enum": ["SUPER_ADMIN", "DOKTER_SPOG", "ASISTEN_DOKTER"] },
        "strNumber": { "type": "string", "maxLength": 80 },
        "sipNumber": { "type": "string", "maxLength": 80 },
        "signatureUrl": { "type": "string", "maxLength": 350000 },
        "active": { "type": "boolean" },
        "e2eeSalt": { "type": "string", "maxLength": 128 },
        "e2eeWrappedKey": { "type": "string", "maxLength": 1024 },
        "e2eeFingerprint": { "type": "string", "maxLength": 64 },
        "e2eePublicKey": { "type": "string", "maxLength": 1024 },
        "lastLoginAt": { "type": "string", "format": "date-time" },
        "isDemo": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "createdBy": { "type": "string", "maxLength": 128 },
        "updatedAt": { "type": "string", "format": "date-time" },
        "updatedBy": { "type": "string", "maxLength": 128 }
      },
      "required": ["id", "displayName", "role", "active", "createdAt", "createdBy", "updatedAt", "updatedBy"]
    },
    "StaffEmailLookup": {
      "title": "StaffEmailLookup",
      "description": "Email-indexed role and active status lookup for Firebase Google Auth staff provisioning",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 160 },
        "userId": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "format": "email", "maxLength": 160 },
        "username": { "type": "string", "maxLength": 64 },
        "displayName": { "type": "string", "maxLength": 120 },
        "role": { "type": "string", "enum": ["SUPER_ADMIN", "DOKTER_SPOG", "ASISTEN_DOKTER"] },
        "strNumber": { "type": "string", "maxLength": 80 },
        "sipNumber": { "type": "string", "maxLength": 80 },
        "signatureUrl": { "type": "string", "maxLength": 350000 },
        "active": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "createdBy": { "type": "string", "maxLength": 128 },
        "updatedAt": { "type": "string", "format": "date-time" },
        "updatedBy": { "type": "string", "maxLength": 128 }
      },
      "required": ["id", "userId", "email", "displayName", "role", "active", "createdAt", "createdBy", "updatedAt", "updatedBy"]
    },
    "RoleDefinition": {
      "title": "RoleDefinition",
      "description": "Role metadata and granular permission keys",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 64 },
        "name": { "type": "string", "maxLength": 80 },
        "description": { "type": "string", "maxLength": 400 },
        "permissions": { "type": "array" },
        "active": { "type": "boolean" },
        "createdAt": { "type": "string" },
        "createdBy": { "type": "string" },
        "updatedAt": { "type": "string" },
        "updatedBy": { "type": "string" }
      },
      "required": ["id", "name", "active", "createdAt", "createdBy", "updatedAt", "updatedBy"]
    },
    "PermissionDefinition": {
